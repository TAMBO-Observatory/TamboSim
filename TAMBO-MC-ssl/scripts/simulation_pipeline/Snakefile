# =============================================================================
# Rule: compute_event_rate
# =============================================================================
# Compute expected event rate from hits file (bypasses trigger)
rule compute_event_rate:
    input:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    output:
        rate_file = f"{TAMBO_DATA_PATH}/{{config}}/rate/{{config}}_{{simset_id}}_rate.txt"
    resources:
        cpus_per_task=1,
        mem_mb=4000,
        slurm_partition="sapphire,shared",
        runtime=1*60
    shell:
        f"""
        julia {PIPELINE_DIR}/compute_event_rate.jl \
            --input {{input.hits_file}} \
            > {{output.rate_file}}
        """


# =============================================================================
# Usage example:
# =============================================================================
# To run the full pipeline for a specific config and simset_id:
#   snakemake --profile slurm $TAMBO_DATA_PATH/{config}/triggered/{config}_{simset_id}_triggered.jld2
#
# For example:
#   snakemake --profile slurm $TAMBO_DATA_PATH/tambo_config/triggered/tambo_config_00001_triggered.jld2
