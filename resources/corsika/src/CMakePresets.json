{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Local build (corsika_upstream + Conan)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/research/corsika/build/conan_toolchain.cmake",
        "corsika_DIR": "$env{HOME}/research/corsika_upstream/build"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
