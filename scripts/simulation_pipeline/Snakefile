"""
Snakemake workflow for TAMBO simulation pipeline.

Automatically detects particle type (neutrino vs proton) from the TOML config
file and dispatches to the appropriate scripts.

Pipeline steps:
1. inject - Generate injections (neutrino: TauRunner + PROPOSAL, proton: direct sampling)
2. take_shower - Run CORSIKA for each shower particle (parallel via Slurm)
3. process_corsika_hits - Process all showers and compute detector hits
4. apply_trigger - Apply trigger logic to select events

Environment variables required:
- TAMBOSIM_PATH: Path to TAMBOSim repository
- TAMBO_DATA_PATH: Path for output data

Example usage:
    snakemake --executor slurm --jobs 9000 -s $TAMBOSIM_PATH/scripts/simulation_pipeline/Snakefile \
        $TAMBO_DATA_PATH/{config}/triggered/{config}_{simset_id}_triggered.jld2
"""

import json
import subprocess
import toml
from os import environ

TAMBOSIM_PATH = environ['TAMBOSIM_PATH']
TAMBO_DATA_PATH = environ['TAMBO_DATA_PATH']
PIPELINE_DIR = f"{TAMBOSIM_PATH}/scripts/simulation_pipeline"


# =============================================================================
# Helper: detect particle type from config
# =============================================================================
def get_particle_type(config):
    """
    Read the TOML config file and determine the particle type from the pdg code.
    Returns 'proton' if pdg == 2212, 'neutrino' otherwise.
    """
    config_path = f"{TAMBOSIM_PATH}/resources/configuration_examples/{config}.toml"
    cfg = toml.load(config_path)
    pdg = cfg["injection"]["pdg"]
    if pdg == 2212:
        return "proton"
    else:
        return "neutrino"


# =============================================================================
# Checkpoint: inject
# =============================================================================
# Dispatches to inject_neutrinos.jl or inject_protons.jl based on config
checkpoint inject:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml"
    output:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    params:
        script = lambda wildcards: f"{PIPELINE_DIR}/inject_protons.jl" if get_particle_type(wildcards.config) == "proton" else f"{PIPELINE_DIR}/inject_neutrinos.jl"
    resources:
        cpus_per_task=1,
        mem_mb=10000,
        slurm_partition="sapphire,shared",
        runtime=8*60
    shell:
        """
        julia {params.script} \
            --config {input.config} \
            --simset_id {wildcards.simset_id} \
            --output {output.injection_file}
        """


# =============================================================================
# Rule: take_shower
# =============================================================================
# Runs CORSIKA for a single shower particle.
# For neutrinos: one shower per decay product (variable decay_id)
# For protons: one shower per event (decay_id is always 1)
rule take_shower:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml",
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    output:
        particles = f"{TAMBO_DATA_PATH}/{{config}}/showers/{{simset_id}}/event_{{event_id}}/shower_{{decay_id}}/particles/particles.parquet"
    params:
        script = lambda wildcards: f"{PIPELINE_DIR}/take_proton_shower.jl" if get_particle_type(wildcards.config) == "proton" else f"{PIPELINE_DIR}/take_shower.jl",
        decay_id_arg = lambda wildcards: "" if get_particle_type(wildcards.config) == "proton" else f"--decay_id {wildcards.decay_id}"
    resources:
        cpus_per_task=1,
        mem_mb=16000,
        slurm_partition="serial_requeue",
        runtime = lambda wildcards: 48*60 if get_particle_type(wildcards.config) == "proton" else 24*60
    shell:
        """
        julia {params.script} \
            --config {input.config} \
            --injection_file {input.injection_file} \
            --shower_dir {TAMBO_DATA_PATH}/{wildcards.config}/showers/{wildcards.simset_id} \
            --event_id {wildcards.event_id} \
            {params.decay_id_arg} \
            --simset_id {wildcards.simset_id}
        """


# =============================================================================
# Helper: dynamic shower job discovery
# =============================================================================
def get_shower_jobs(wildcards):
    """
    After the inject checkpoint completes, read the injection file to determine
    which shower jobs need to run. Dispatches to the appropriate listing script
    based on particle type.
    """
    ptype = get_particle_type(wildcards.config)
    checkpoint_output = checkpoints.inject.get(**wildcards).output.injection_file

    if ptype == "proton":
        list_script = f"{PIPELINE_DIR}/list_proton_shower_jobs.jl"
    else:
        list_script = f"{PIPELINE_DIR}/list_shower_jobs.jl"

    result = subprocess.run(
        ["julia", list_script, "--injection_file", checkpoint_output],
        capture_output=True,
        text=True,
        check=True
    )

    jobs = json.loads(result.stdout)

    shower_files = []
    for job in jobs:
        event_id = str(job["event_id"]).zfill(6)
        if ptype == "proton":
            decay_id = 1
        else:
            decay_id = job["decay_id"]
        shower_file = f"{TAMBO_DATA_PATH}/{wildcards.config}/showers/{wildcards.simset_id}/event_{event_id}/shower_{decay_id}/particles/particles.parquet"
        shower_files.append(shower_file)

    return shower_files


# =============================================================================
# Rule: process_corsika_hits
# =============================================================================
# Aggregates all shower outputs and computes detector hits
rule process_corsika_hits:
    input:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2",
        showers = get_shower_jobs
    output:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    params:
        n_threads = 8
    threads: 8
    resources:
        cpus_per_task=8,
        mem_mb=16000,
        slurm_partition="sapphire,shared",
        runtime = lambda wildcards: 24*60 if get_particle_type(wildcards.config) == "proton" else 4*60
    shell:
        f"""
        julia --threads {{params.n_threads}} {PIPELINE_DIR}/process_corsika_hits.jl \
            --injection_file {{input.injection_file}} \
            --shower_dir {TAMBO_DATA_PATH}/{{wildcards.config}}/showers/{{wildcards.simset_id}} \
            --output {{output.hits_file}}
        """


# =============================================================================
# Rule: apply_trigger
# =============================================================================
# Applies trigger logic to select events
rule apply_trigger:
    input:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    output:
        triggered_file = f"{TAMBO_DATA_PATH}/{{config}}/triggered/{{config}}_{{simset_id}}_triggered.jld2"
    params:
        module_threshold = 3,
        event_threshold = 30,
        min_modules = 3
    resources:
        cpus_per_task=1,
        mem_mb=4000,
        slurm_partition="sapphire,shared",
        runtime=1*60
    shell:
        f"""
        julia {PIPELINE_DIR}/apply_trigger.jl \
            --input {{input.hits_file}} \
            --output {{output.triggered_file}} \
            --module_threshold {{params.module_threshold}} \
            --event_threshold {{params.event_threshold}} \
            --min_modules {{params.min_modules}}
        """


# =============================================================================
# Usage examples:
# =============================================================================
# The pipeline auto-detects particle type from the [injection] pdg field.
# Proton configs have pdg = 2212, neutrino configs have pdg = 16 or 14.
#
# Neutrino example:
#   snakemake --executor slurm --jobs 9000 -s $TAMBOSIM_PATH/scripts/simulation_pipeline/Snakefile \
#       $TAMBO_DATA_PATH/jeff_config/triggered/jeff_config_00001_triggered.jld2
#
# Proton example:
#   snakemake --executor slurm --jobs 9000 -s $TAMBOSIM_PATH/scripts/simulation_pipeline/Snakefile \
#       $TAMBO_DATA_PATH/proton_low_energy/triggered/proton_low_energy_00001_triggered.jld2
