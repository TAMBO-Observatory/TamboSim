"""
Snakemake workflow for TAMBO simulation pipeline.

Pipeline steps:
1. inject_neutrinos - Generate neutrino injections and tau decays
2. take_shower - Run CORSIKA for each decay particle (parallel via Slurm)
3. process_corsika_hits - Process all showers and compute detector hits
4. apply_trigger - Apply trigger logic to select events

Environment variables required:
- TAMBOSIM_PATH: Path to TAMBOSim repository
- TAMBO_DATA_PATH: Path for output data

Example usage:
    snakemake --profile slurm {TAMBO_DATA_PATH}/{config}/triggered/{config}_{simset_id}_triggered.jld2
"""

import json
import subprocess
from os import environ

TAMBOSIM_PATH = environ['TAMBOSIM_PATH']
TAMBO_DATA_PATH = environ['TAMBO_DATA_PATH']
PIPELINE_DIR = f"{TAMBOSIM_PATH}/scripts/simulation_pipeline"


# =============================================================================
# Checkpoint: inject_neutrinos
# =============================================================================
# This checkpoint allows dynamic expansion of CORSIKA jobs after injection
checkpoint inject_neutrinos:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml"
    output:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    resources:
        cpus_per_task=1,
        mem_mb=10000,
        slurm_partition="sapphire,shared",
        runtime=8*60
    shell:
        f"""
        julia {PIPELINE_DIR}/inject_neutrinos.jl \
            --config {{input.config}} \
            --simset_id {{wildcards.simset_id}} \
            --output {{output.injection_file}}
        """


# =============================================================================
# Rule: take_shower
# =============================================================================
# Runs CORSIKA for a single decay particle
rule take_shower:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml",
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    output:
        particles = f"{TAMBO_DATA_PATH}/{{config}}/showers/{{simset_id}}/event_{{event_id}}/shower_{{decay_id}}/particles/particles.parquet"
    resources:
        cpus_per_task=1,
        mem_mb=16000,
        slurm_partition="sapphire,shared",
        runtime=24*60
    shell:
        f"""
        julia {PIPELINE_DIR}/take_shower.jl \
            --config {{input.config}} \
            --injection_file {{input.injection_file}} \
            --shower_dir {TAMBO_DATA_PATH}/{{wildcards.config}}/showers/{{wildcards.simset_id}} \
            --event_id {{wildcards.event_id}} \
            --decay_id {{wildcards.decay_id}} \
            --simset_id {{wildcards.simset_id}}
        """


# =============================================================================
# Helper functions for dynamic job discovery
# =============================================================================
def get_shower_jobs(wildcards):
    """
    After the inject_neutrinos checkpoint completes, read the injection file
    to determine which shower jobs need to run.

    Returns list of output particle.parquet files expected.
    """
    # Get the checkpoint output to ensure injection has completed
    checkpoint_output = checkpoints.inject_neutrinos.get(**wildcards).output.injection_file

    # Run Julia helper script to get event_id/decay_id pairs
    result = subprocess.run(
        ["julia", f"{PIPELINE_DIR}/list_shower_jobs.jl", "--injection_file", checkpoint_output],
        capture_output=True,
        text=True,
        check=True
    )

    jobs = json.loads(result.stdout)

    # Build list of expected output files
    shower_files = []
    for job in jobs:
        event_id = str(job["event_id"]).zfill(6)
        decay_id = job["decay_id"]
        shower_file = f"{TAMBO_DATA_PATH}/{wildcards.config}/showers/{wildcards.simset_id}/event_{event_id}/shower_{decay_id}/particles/particles.parquet"
        shower_files.append(shower_file)

    return shower_files


# =============================================================================
# Rule: process_corsika_hits
# =============================================================================
# Aggregates all shower outputs and computes detector hits
rule process_corsika_hits:
    input:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2",
        showers = get_shower_jobs
    output:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    threads: 32
    resources:
        cpus_per_task=32,
        mem_mb=8000,
        slurm_partition="sapphire,shared",
        runtime=4*60
    shell:
        f"""
        julia --threads {{threads}} {PIPELINE_DIR}/process_corsika_hits.jl \
            --injection_file {{input.injection_file}} \
            --shower_dir {TAMBO_DATA_PATH}/{{wildcards.config}}/showers/{{wildcards.simset_id}} \
            --output {{output.hits_file}}
        """


# =============================================================================
# Rule: apply_trigger
# =============================================================================
# Applies trigger logic to select events
rule apply_trigger:
    input:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    output:
        triggered_file = f"{TAMBO_DATA_PATH}/{{config}}/triggered/{{config}}_{{simset_id}}_triggered.jld2"
    params:
        module_threshold = 3,
        event_threshold = 30,
        min_modules = 3
    resources:
        cpus_per_task=1,
        mem_mb=4000,
        slurm_partition="sapphire,shared",
        runtime=1*60
    shell:
        f"""
        julia {PIPELINE_DIR}/apply_trigger.jl \
            --input {{input.hits_file}} \
            --output {{output.triggered_file}} \
            --module_threshold {{params.module_threshold}} \
            --event_threshold {{params.event_threshold}} \
            --min_modules {{params.min_modules}}
        """


# =============================================================================
# Proton pipeline
# =============================================================================

# =============================================================================
# Checkpoint: inject_protons
# =============================================================================
# This checkpoint allows dynamic expansion of proton CORSIKA jobs after injection
checkpoint inject_protons:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml"
    output:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    resources:
        cpus_per_task=1,
        mem_mb=10000,
        slurm_partition="sapphire,shared",
        runtime=4*60
    shell:
        f"""
        julia {PIPELINE_DIR}/inject_protons.jl \
            --config {{input.config}} \
            --simset_id {{wildcards.simset_id}} \
            --output {{output.injection_file}}
        """


# =============================================================================
# Rule: take_proton_shower
# =============================================================================
# Runs CORSIKA for a single proton (one shower per event, no decay_id)
rule take_proton_shower:
    input:
        config = lambda wildcards: f"{TAMBOSIM_PATH}/resources/configuration_examples/{wildcards.config}.toml",
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2"
    output:
        particles = f"{TAMBO_DATA_PATH}/{{config}}/showers/{{simset_id}}/event_{{event_id}}/shower_1/particles/particles.parquet"
    resources:
        cpus_per_task=1,
        mem_mb=16000,
        slurm_partition="sapphire,shared",
        runtime=48*60
    shell:
        f"""
        julia {PIPELINE_DIR}/take_proton_shower.jl \
            --config {{input.config}} \
            --injection_file {{input.injection_file}} \
            --shower_dir {TAMBO_DATA_PATH}/{{wildcards.config}}/showers/{{wildcards.simset_id}} \
            --event_id {{wildcards.event_id}} \
            --simset_id {{wildcards.simset_id}}
        """


# =============================================================================
# Helper: dynamic proton shower job discovery
# =============================================================================
def get_proton_shower_jobs(wildcards):
    """
    After the inject_protons checkpoint completes, read the injection file
    to determine which proton shower jobs need to run.

    Returns list of output particle.parquet files expected.
    """
    checkpoint_output = checkpoints.inject_protons.get(**wildcards).output.injection_file

    result = subprocess.run(
        ["julia", f"{PIPELINE_DIR}/list_proton_shower_jobs.jl", "--injection_file", checkpoint_output],
        capture_output=True,
        text=True,
        check=True
    )

    jobs = json.loads(result.stdout)

    shower_files = []
    for job in jobs:
        event_id = str(job["event_id"]).zfill(6)
        shower_file = f"{TAMBO_DATA_PATH}/{wildcards.config}/showers/{wildcards.simset_id}/event_{event_id}/shower_1/particles/particles.parquet"
        shower_files.append(shower_file)

    return shower_files


# =============================================================================
# Rule: process_proton_corsika_hits
# =============================================================================
# Reuses process_corsika_hits.jl with proton shower directories
rule process_proton_corsika_hits:
    input:
        injection_file = f"{TAMBO_DATA_PATH}/{{config}}/injection/{{config}}_{{simset_id}}.jld2",
        showers = get_proton_shower_jobs
    output:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    threads: 4
    resources:
        cpus_per_task=4,
        mem_mb=16000,
        slurm_partition="sapphire,shared",
        runtime=24*60
    shell:
        f"""
        julia --threads {{threads}} {PIPELINE_DIR}/process_corsika_hits.jl \
            --injection_file {{input.injection_file}} \
            --shower_dir {TAMBO_DATA_PATH}/{{wildcards.config}}/showers/{{wildcards.simset_id}} \
            --output {{output.hits_file}}
        """


# =============================================================================
# Rule: apply_proton_trigger
# =============================================================================
# Applies trigger logic to proton events (reuses apply_trigger.jl)
rule apply_proton_trigger:
    input:
        hits_file = f"{TAMBO_DATA_PATH}/{{config}}/hits/{{config}}_{{simset_id}}_hits.jld2"
    output:
        triggered_file = f"{TAMBO_DATA_PATH}/{{config}}/triggered/{{config}}_{{simset_id}}_triggered.jld2"
    params:
        module_threshold = 3,
        event_threshold = 30,
        min_modules = 3
    resources:
        cpus_per_task=1,
        mem_mb=4000,
        slurm_partition="sapphire,shared",
        runtime=1*60
    shell:
        f"""
        julia {PIPELINE_DIR}/apply_trigger.jl \
            --input {{input.hits_file}} \
            --output {{output.triggered_file}} \
            --module_threshold {{params.module_threshold}} \
            --event_threshold {{params.event_threshold}} \
            --min_modules {{params.min_modules}}
        """


# =============================================================================
# Usage examples:
# =============================================================================
# Neutrino pipeline:
#   snakemake --profile slurm $TAMBO_DATA_PATH/{config}/triggered/{config}_{simset_id}_triggered.jld2
#
# Proton pipeline:
#   snakemake --profile slurm $TAMBO_DATA_PATH/{config}/triggered/{config}_{simset_id}_triggered.jld2
#
# For example:
#   snakemake --profile slurm $TAMBO_DATA_PATH/tambo_config/triggered/tambo_config_00001_triggered.jld2
#   snakemake --profile slurm $TAMBO_DATA_PATH/tambo_config/triggered/tambo_config_00001_triggered.jld2
