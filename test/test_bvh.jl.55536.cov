        1 function test_aabb_merge(a::TestAABB{T}, b::TestAABB{T}) where {T}
        1     cs = a.min_corner.coordinate_system
        1     min_corner = TestCoordinate([
        -         min(a.min_corner[1], b.min_corner[1]),
        -         min(a.min_corner[2], b.min_corner[2]),
