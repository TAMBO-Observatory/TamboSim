        1 function test_aabb_center(aabb::TestAABB{T}) where {T}
        1     return SVector{3}(
        -         (aabb.min_corner[1] + aabb.max_corner[1]) / 2,
        -         (aabb.min_corner[2] + aabb.max_corner[2]) / 2,
        -         (aabb.min_corner[3] + aabb.max_corner[3]) / 2
        -     )
        - end
