        4             if !isnothing(t)
        -                 # Find actual index in global triangle list
        4                 for (j, global_tri) in enumerate(all_triangles)
        3                     if global_tri === tri
        2                         push!(results, TestBVHIntersection{T}(true, t, j))
        2                         break
        -                     end
        1                 end
        -             end
        2         end
        -     else
        -         # Recurse into children
        0         if !isnothing(node.left)
        0             test_bvh_node_intersect_all!(results, node.left, ray, all_triangles)
