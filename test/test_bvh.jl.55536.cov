        3 function test_ray_aabb_intersect(ray::TestRay{T}, aabb::TestAABB{T}) where {T}
        -     # Slab method for ray-AABB intersection
        3     tmin = -Inf
        3     tmax = Inf
        - 
        3     for i in 1:3
        7         origin_i = ustrip(ray.origin[i])
        7         dir_i = ray.direction[i]
        7         min_i = ustrip(aabb.min_corner[i])
        7         max_i = ustrip(aabb.max_corner[i])
        - 
        7         if abs(dir_i) < 1e-9
        -             # Ray is parallel to slab
       10             if origin_i < min_i || origin_i > max_i
        1                 return false
        -             end
        -         else
        2             t1 = (min_i - origin_i) / dir_i
        2             t2 = (max_i - origin_i) / dir_i
        - 
        2             if t1 > t2
        0                 t1, t2 = t2, t1
        -             end
        - 
        2             tmin = max(tmin, t1)
        2             tmax = min(tmax, t2)
        - 
        2             if tmin > tmax
        0                 return false
        -             end
        -         end
       10     end
        - 
        2     return tmax >= 0
        - end
