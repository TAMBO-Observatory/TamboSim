        - # ============================================================================
        - # AABB (Axis-Aligned Bounding Box) for testing
        - # ============================================================================
        - 
        - struct TestAABB{T<:Real}
       13     min_corner::TestCoordinate{T}
        -     max_corner::TestCoordinate{T}
        - end
        - 
        8 function TestAABB(triangles::Vector{TestTriangle{T}}) where {T}
        8     if isempty(triangles)
        0         error("Cannot create AABB from empty triangle list")
        -     end
        - 
        8     cs = triangles[1].v1.coordinate_system
        - 
        -     # Initialize with first triangle's vertices
       16     min_x = min(triangles[1].v1[1], triangles[1].v2[1], triangles[1].v3[1])
       16     min_y = min(triangles[1].v1[2], triangles[1].v2[2], triangles[1].v3[2])
       16     min_z = min(triangles[1].v1[3], triangles[1].v2[3], triangles[1].v3[3])
       16     max_x = max(triangles[1].v1[1], triangles[1].v2[1], triangles[1].v3[1])
       16     max_y = max(triangles[1].v1[2], triangles[1].v2[2], triangles[1].v3[2])
       16     max_z = max(triangles[1].v1[3], triangles[1].v2[3], triangles[1].v3[3])
        - 
        -     # Expand to include all triangles
        8     for tri in triangles[2:end]
       18         min_x = min(min_x, tri.v1[1], tri.v2[1], tri.v3[1])
       18         min_y = min(min_y, tri.v1[2], tri.v2[2], tri.v3[2])
       18         min_z = min(min_z, tri.v1[3], tri.v2[3], tri.v3[3])
       18         max_x = max(max_x, tri.v1[1], tri.v2[1], tri.v3[1])
       18         max_y = max(max_y, tri.v1[2], tri.v2[2], tri.v3[2])
       18         max_z = max(max_z, tri.v1[3], tri.v2[3], tri.v3[3])
        9     end
        - 
        8     min_corner = TestCoordinate([min_x, min_y, min_z], cs)
        8     max_corner = TestCoordinate([max_x, max_y, max_z], cs)
        - 
        8     return TestAABB{T}(min_corner, max_corner)
        - end
