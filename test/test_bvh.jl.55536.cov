        1 function test_bvh_intersect_all(bvh::TestBVHTree{T}, ray::TestRay{T}) where {T}
        1     results = TestBVHIntersection{T}[]
        1     test_bvh_node_intersect_all!(results, bvh.root, ray, bvh.triangles)
        3     sort!(results, by=ix -> ix.distance)
        1     return results
        - end
