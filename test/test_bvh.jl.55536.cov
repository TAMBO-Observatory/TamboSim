        - # ============================================================================
        - # BVH Tree for testing
        - # ============================================================================
        - 
        - struct TestBVHNode{T<:Real}
        7     aabb::TestAABB{T}
        -     left::Union{Nothing, TestBVHNode{T}}
        -     right::Union{Nothing, TestBVHNode{T}}
        -     triangles::Vector{TestTriangle{T}}  # Only for leaf nodes
        -     is_leaf::Bool
        - end
        - 
        - struct TestBVHTree{T<:Real}
        5     root::TestBVHNode{T}
        -     triangles::Vector{TestTriangle{T}}
        - end
        - 
       10 function test_build_bvh(triangles::Vector{TestTriangle{T}}, max_leaf_size::Int=4) where {T}
       10     root = test_build_bvh_node(triangles, max_leaf_size)
        5     return TestBVHTree{T}(root, triangles)
        - end
        - 
        7 function test_build_bvh_node(triangles::Vector{TestTriangle{T}}, max_leaf_size::Int) where {T}
        7     aabb = TestAABB(triangles)
        - 
        7     if length(triangles) <= max_leaf_size
        -         # Create leaf node
        6         return TestBVHNode{T}(aabb, nothing, nothing, triangles, true)
        -     end
        - 
        -     # Find best axis to split on (use longest axis)
        1     extent = aabb.max_corner.point - aabb.min_corner.point
        3     axis = argmax(ustrip.(extent))
        - 
        -     # Sort triangles by centroid on the split axis
       10     sorted_tris = sort(triangles, by=tri -> begin
        8         centroid = (tri.v1.point + tri.v2.point + tri.v3.point) / 3
        8         return ustrip(centroid[axis])
        -     end)
        - 
        -     # Split in half
        1     mid = div(length(sorted_tris), 2)
        2     left_tris = sorted_tris[1:mid]
        2     right_tris = sorted_tris[mid+1:end]
        - 
        1     left = test_build_bvh_node(left_tris, max_leaf_size)
        1     right = test_build_bvh_node(right_tris, max_leaf_size)
        - 
        1     return TestBVHNode{T}(aabb, left, right, TestTriangle{T}[], false)
        - end
        - 
        - struct TestBVHIntersection{T<:Real}
        3     hit::Bool
        -     distance::Quantity{T, ldim, typeof(u"m")}
        -     triangle_idx::Int
        - end
        - 
        2 function test_bvh_intersect(bvh::TestBVHTree{T}, ray::TestRay{T}) where {T}
        2     return test_bvh_node_intersect(bvh.root, ray, bvh.triangles)
        - end
        - 
        2 function test_bvh_node_intersect(node::TestBVHNode{T}, ray::TestRay{T}, all_triangles::Vector{TestTriangle{T}}) where {T}
        -     # First check if ray intersects AABB
        2     if !test_ray_aabb_intersect(ray, node.aabb)
        1         return nothing
        -     end
        - 
        1     if node.is_leaf
        -         # Test all triangles in leaf
        1         closest_t = Inf * u"m"
        1         closest_idx = -1
        - 
        2         for (i, tri) in enumerate(node.triangles)
        1             t = test_ray_triangle_intersect(ray, tri)
        2             if !isnothing(t) && t < closest_t
        1                 closest_t = t
        -                 # Find actual index in global triangle list
        2                 for (j, global_tri) in enumerate(all_triangles)
        1                     if global_tri === tri
        1                         closest_idx = j
        1                         break
        -                     end
        0                 end
        -             end
        1         end
        - 
        1         if closest_idx > 0
        1             return TestBVHIntersection{T}(true, closest_t, closest_idx)
        -         else
        0             return nothing
        -         end
        -     else
        -         # Recurse into children
        0         left_hit = isnothing(node.left) ? nothing : test_bvh_node_intersect(node.left, ray, all_triangles)
        0         right_hit = isnothing(node.right) ? nothing : test_bvh_node_intersect(node.right, ray, all_triangles)
        - 
        0         if isnothing(left_hit) && isnothing(right_hit)
        0             return nothing
        0         elseif isnothing(left_hit)
        0             return right_hit
        0         elseif isnothing(right_hit)
        0             return left_hit
        -         else
        0             return left_hit.distance < right_hit.distance ? left_hit : right_hit
        -         end
        -     end
        - end
