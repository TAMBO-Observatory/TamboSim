        - """
        - Tests for the BVH (Bounding Volume Hierarchy) tree structure.
        - 
        - These tests use the actual Tambo types from src/ to ensure code coverage.
        - """
        - 
        - # Import BVH-related functions
        - import Tambo: merge, surface_area, center
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_bvh_tests()
        1     @testset "AABB" begin
        2         test_aabb_construction()
        1         test_aabb_from_triangles()
        1         test_aabb_merge_test()
        1         test_aabb_center_test()
        -     end
        - 
        0     @testset "BVH Construction" begin
        2         test_bvh_construction_single_triangle()
        1         test_bvh_construction_multiple_triangles()
        -     end
        - 
        0     @testset "BVH Intersection" begin
        2         test_bvh_intersect_single()
        1         test_bvh_intersect_all_test()
        1         test_bvh_intersect_miss()
        -     end
        - end
        - 
        - # AABB tests
        1 function test_aabb_construction()
        1     cs = ecefcoordinates
        1     min_corner = Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     max_corner = Coordinate([10.0u"m", 10.0u"m", 10.0u"m"], cs)
        - 
        1     aabb = AABB(min_corner, max_corner)
        - 
        1     @test aabb.min == min_corner
        1     @test aabb.max == max_corner
        - end
        - 
        1 function test_aabb_from_triangles()
        1     cs = ecefcoordinates
        - 
        -     # Create triangles at different locations
        1     tri1 = Triangle(
        -         Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([1.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([0.0u"m", 1.0u"m", 0.0u"m"], cs)
        -     )
        - 
        1     tri2 = Triangle(
        -         Coordinate([5.0u"m", 5.0u"m", 5.0u"m"], cs),
        -         Coordinate([6.0u"m", 5.0u"m", 5.0u"m"], cs),
        -         Coordinate([5.0u"m", 6.0u"m", 5.0u"m"], cs)
        -     )
        - 
        2     aabb = AABB([tri1, tri2])
        - 
        -     # AABB should encompass both triangles
        1     @test aabb.min[1] <= 0.0u"m"
        1     @test aabb.min[2] <= 0.0u"m"
        1     @test aabb.min[3] <= 0.0u"m"
        1     @test aabb.max[1] >= 6.0u"m"
        1     @test aabb.max[2] >= 6.0u"m"
        1     @test aabb.max[3] >= 5.0u"m"
        - end
        - 
        1 function test_aabb_merge_test()
        1     cs = ecefcoordinates
        - 
        1     aabb1 = AABB(
        -         Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([5.0u"m", 5.0u"m", 5.0u"m"], cs)
        -     )
        - 
        1     aabb2 = AABB(
        -         Coordinate([3.0u"m", 3.0u"m", 3.0u"m"], cs),
        -         Coordinate([10.0u"m", 10.0u"m", 10.0u"m"], cs)
        -     )
        - 
        2     merged = merge(aabb1, aabb2)
        - 
        1     @test merged.min[1] == 0.0u"m"
        1     @test merged.min[2] == 0.0u"m"
        1     @test merged.min[3] == 0.0u"m"
        1     @test merged.max[1] == 10.0u"m"
        1     @test merged.max[2] == 10.0u"m"
        1     @test merged.max[3] == 10.0u"m"
        - end
        - 
        1 function test_aabb_center_test()
        1     cs = ecefcoordinates
        - 
        1     aabb = AABB(
        -         Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([10.0u"m", 10.0u"m", 10.0u"m"], cs)
        -     )
        - 
        1     c = center(aabb)
        - 
        1     @test c[1] == 5.0u"m"
        1     @test c[2] == 5.0u"m"
        1     @test c[3] == 5.0u"m"
        - end
        - 
        - # BVH Construction tests
        1 function test_bvh_construction_single_triangle()
        1     cs = ecefcoordinates
        - 
        1     tri = Triangle(
        -         Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([1.0u"m", 0.0u"m", 0.0u"m"], cs),
        -         Coordinate([0.0u"m", 1.0u"m", 0.0u"m"], cs)
        -     )
        - 
        1     bvh = BVHTree([tri])
        - 
        1     @test bvh isa BVHTree
        1     @test length(bvh.triangles) == 1
        - end
        - 
        1 function test_bvh_construction_multiple_triangles()
        1     cs = ecefcoordinates
        - 
        -     # Create multiple triangles
        1     triangles = Triangle{Float64}[]
        1     for i in 0:4
        5         tri = Triangle(
        -             Coordinate([Float64(i)*u"m", 0.0u"m", 0.0u"m"], cs),
        -             Coordinate([Float64(i+1)*u"m", 0.0u"m", 0.0u"m"], cs),
        -             Coordinate([Float64(i+0.5)*u"m", 1.0u"m", 0.0u"m"], cs)
        -         )
        5         push!(triangles, tri)
        9     end
        - 
        1     bvh = BVHTree(triangles)
        - 
        1     @test bvh isa BVHTree
        1     @test length(bvh.triangles) == 5
        - end
        - 
        - # BVH Intersection tests
        1 function test_bvh_intersect_single()
        1     cs = ecefcoordinates
        - 
        -     # Create a single triangle in the XY plane at z=10
        1     tri = Triangle(
        -         Coordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        -     )
        - 
        1     bvh = BVHTree([tri])
        - 
        -     # Ray pointing in +z direction from origin should hit the triangle
        1     origin = Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     direction = Direction([0.0, 0.0, 1.0], cs)
        1     ray = Ray(origin, direction)
        - 
        2     intersection = find_intersect(ray, bvh)
        - 
        4     @test !isnothing(intersection)
        2     @test intersection.hit
        1     @test intersection.distance ≈ 10.0u"m"
        - end
        - 
        1 function test_bvh_intersect_all_test()
        1     cs = ecefcoordinates
        - 
        -     # Create two triangles at different z positions
        1     tri1 = Triangle(
        -         Coordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        -     )
        - 
        1     tri2 = Triangle(
        -         Coordinate([-5.0u"m", -5.0u"m", 20.0u"m"], cs),
        -         Coordinate([5.0u"m", -5.0u"m", 20.0u"m"], cs),
        -         Coordinate([0.0u"m", 5.0u"m", 20.0u"m"], cs)
        -     )
        - 
        2     bvh = BVHTree([tri1, tri2])
        - 
        -     # Ray pointing in +z direction should hit both triangles
        1     origin = Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     direction = Direction([0.0, 0.0, 1.0], cs)
        1     ray = Ray(origin, direction)
        - 
        1     intersections = intersect_all(bvh, ray)
        - 
        1     @test length(intersections) == 2
        -     # First intersection should be closer
        1     @test intersections[1].distance < intersections[2].distance
        1     @test intersections[1].distance ≈ 10.0u"m"
        1     @test intersections[2].distance ≈ 20.0u"m"
        - end
        - 
        1 function test_bvh_intersect_miss()
        1     cs = ecefcoordinates
        - 
        -     # Create a triangle
        1     tri = Triangle(
        -         Coordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs),
        -         Coordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        -     )
        - 
        1     bvh = BVHTree([tri])
        - 
        -     # Ray far away from the triangle should miss
        1     origin = Coordinate([100.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     direction = Direction([0.0, 0.0, 1.0], cs)
        1     ray = Ray(origin, direction)
        - 
        1     intersection = find_intersect(ray, bvh)
        2     @test isnothing(intersection)
        - end
