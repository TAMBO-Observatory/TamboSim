        1 function test_frame_parent_lookup()
        1     grandparent = TestFrame(Dict("level" => "grandparent", "gp_key" => 100))
        1     parent = TestFrame(Dict("level" => "parent", "p_key" => 200), grandparent, 'P')
        1     child = TestFrame(Dict("level" => "child", "c_key" => 300), parent, 'C')
        - 
        1     @test child["gp_key"] == 100
        1     @test child["p_key"] == 200
        1     @test child["c_key"] == 300
        - end
        - 
        1 function test_frame_override_parent()
        2     parent = TestFrame(Dict("key" => "parent_value"))
        2     child = TestFrame(Dict("key" => "child_value"), parent, 'C')
        - 
        1     @test child["key"] == "child_value"
        1     @test parent["key"] == "parent_value"
        - end
        - 
        1 function test_frame_multi_level_hierarchy()
        2     f1 = TestFrame(Dict("level1" => true))
        2     f2 = TestFrame(Dict("level2" => true), f1, 'A')
        2     f3 = TestFrame(Dict("level3" => true), f2, 'B')
