        - """
        - Tests for the Frame data structure.
        - 
        - These tests use the actual Tambo types from src/ to ensure code coverage.
        - """
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_frame_tests()
        1     @testset "Frame Construction" begin
        2         test_frame_empty_construction()
        1         test_frame_with_data()
        1         test_frame_with_parent()
        -     end
        - 
        0     @testset "Frame Access" begin
        2         test_frame_getindex()
        1         test_frame_setindex()
        1         test_frame_haskey()
        1         test_frame_keys()
        1         test_frame_getkey_default()
        -     end
        - 
        0     @testset "Frame Hierarchy" begin
        2         test_frame_parent_lookup()
        1         test_frame_override_parent()
        1         test_frame_multi_level_hierarchy()
        -     end
        - 
        0     @testset "Frame Utilities" begin
        2         test_cut_frames()
        -     end
        - end
        - 
        1 function test_frame_empty_construction()
        1     f = Frame()
        - 
        1     @test isempty(f.data)
        -     # Note: Frame() constructor only initializes data, leaving parent/type undefined
        -     # Use isdefined to check if parent field is initialized
        2     @test !isdefined(f, :parent) || isnothing(f.parent)
        - end
        - 
        1 function test_frame_with_data()
        1     data = Dict("key1" => 1, "key2" => "value")
        1     f = Frame(data)
        - 
        1     @test f.data == data
        1     @test f["key1"] == 1
        1     @test f["key2"] == "value"
        - end
        - 
        1 function test_frame_with_parent()
        2     parent = Frame(Dict("parent_key" => 100))
        2     child = Frame(Dict("child_key" => 200), parent, 'C')
        - 
        1     @test child.parent == parent
        1     @test child.type == 'C'
        1     @test child["child_key"] == 200
        1     @test child["parent_key"] == 100
        - end
        - 
        1 function test_frame_getindex()
        2     data = Dict("key" => 42)
        1     f = Frame(data)
        - 
        1     @test f["key"] == 42
        3     @test_throws KeyError f["nonexistent"]
        - end
        - 
        1 function test_frame_setindex()
        1     f = Frame()
        - 
        1     f["new_key"] = "new_value"
        - 
        1     @test f["new_key"] == "new_value"
        2     @test haskey(f, "new_key")
        - end
        - 
        1 function test_frame_haskey()
        2     parent = Frame(Dict("parent_key" => 1))
        2     child = Frame(Dict("child_key" => 2), parent, 'C')
        - 
        2     @test haskey(child, "child_key")
        3     @test haskey(child, "parent_key")
        3     @test !haskey(child, "nonexistent")
        - end
        - 
        1 function test_frame_keys()
        1     parent = Frame(Dict("a" => 1, "b" => 2))
        1     child = Frame(Dict("c" => 3, "d" => 4), parent, 'C')
        - 
        1     all_keys = keys(child)
        - 
        1     @test "a" in all_keys
        1     @test "b" in all_keys
        1     @test "c" in all_keys
        1     @test "d" in all_keys
        - end
        - 
        1 function test_frame_getkey_default()
        2     f = Frame(Dict("exists" => 10))
        - 
        1     @test getkey(f, "exists", 0) == 10
        1     @test getkey(f, "nonexistent", 0) == 0
        - end
        - 
        1 function test_frame_parent_lookup()
        1     grandparent = Frame(Dict("level" => "grandparent", "gp_key" => 100))
        1     parent = Frame(Dict("level" => "parent", "p_key" => 200), grandparent, 'P')
        1     child = Frame(Dict("level" => "child", "c_key" => 300), parent, 'C')
        - 
        1     @test child["gp_key"] == 100
        1     @test child["p_key"] == 200
        1     @test child["c_key"] == 300
        - end
        - 
        1 function test_frame_override_parent()
        2     parent = Frame(Dict("key" => "parent_value"))
        2     child = Frame(Dict("key" => "child_value"), parent, 'C')
        - 
        1     @test child["key"] == "child_value"
        1     @test parent["key"] == "parent_value"
        - end
        - 
        1 function test_frame_multi_level_hierarchy()
        2     f1 = Frame(Dict("level1" => true))
        2     f2 = Frame(Dict("level2" => true), f1, 'A')
        2     f3 = Frame(Dict("level3" => true), f2, 'B')
        2     f4 = Frame(Dict("level4" => true), f3, 'C')
        - 
        1     @test f4["level1"] == true
        1     @test f4["level2"] == true
        1     @test f4["level3"] == true
        1     @test f4["level4"] == true
        - end
        - 
        1 function test_cut_frames()
        5     frames = [
        -         Frame(Dict("value" => 10)),
        -         Frame(Dict("value" => 20)),
        -         Frame(Dict("value" => 30)),
        -         Frame(Dict("value" => 40)),
        -         Frame(Dict("value" => 50))
        -     ]
        - 
        6     cut_frames!(frames, f -> f["value"] > 25)
        - 
        1     @test length(frames) == 3
        6     @test all(f -> f["value"] > 25, frames)
        - end
