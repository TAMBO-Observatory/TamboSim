        - """
        - Tests for the particles module including particle types and particle state.
        - """
        - 
        - # ============================================================================
        - # Particle types for testing
        - # ============================================================================
        - 
        - @enum TestParticleType begin
        -     TestUnknown = 0
        -     TestGamma = 22
        -     TestEPlus = -11
        -     TestEMinus = 11
        -     TestMuPlus = -13
        -     TestMuMinus = 13
        -     TestTauPlus = -15
        -     TestTauMinus = 15
        -     TestNuTau = 16
        -     TestNuTauBar = -16
        - end
        - 
        - @enum TestFitStatus begin
        -     TestNotSet = -1
        -     TestOK = 0
        -     TestGeneralFailure = 10
        - end
        - 
        - @enum TestParticleShape begin
        -     TestNull = 0
        - end
        - 
        - # ============================================================================
        - # Particle struct for testing
        - # ============================================================================
        - 
        - struct TestParticle{T<:Real}
        6     id::Int
        -     pdg::TestParticleType
        -     energy::Quantity{T, edim, typeof(u"GeV")}
        -     position::TestCoordinate{T}
        -     direction::TestDirection{T}
        -     time::Quantity{T, tdim, typeof(u"s")}
        -     status::TestFitStatus
        -     shape::TestParticleShape
        -     speed::Quantity{T, ldim/tdim, typeof(u"m/s")}
        - end
        - 
        1 function TestParticle(::Type{T}) where {T}
        1     cs = test_ecef
        1     return TestParticle{T}(
        -         0,
        -         TestUnknown,
        -         NaN * u"GeV",
        -         TestCoordinate([NaN * u"m", NaN * u"m", NaN * u"m"], cs),
        -         TestDirection([0.0, 0.0, -1.0], cs),
        -         NaN * u"s",
        -         TestNotSet,
        -         TestNull,
        -         NaN * u"m/s"
        -     )
        - end
        - 
        5 function TestParticle(pdg::TestParticleType, e, pos::TestCoordinate{T}, dir::TestDirection{T}) where {T}
        5     return TestParticle{T}(
        -         0, pdg, e |> u"GeV", pos, dir, 0.0u"s", TestNotSet, TestNull, 0.0u"m/s"
        -     )
        - end
        - 
        - # Physics functions
        - const test_particle_params = Dict(
        -     TestTauMinus => (1.77686u"GeV" / speedoflight^2, 2.903e-13u"s"),
        -     TestTauPlus => (1.77686u"GeV" / speedoflight^2, 2.903e-13u"s"),
        -     TestMuMinus => (0.1056583745u"GeV" / speedoflight^2, 2.1969811e-6u"s"),
        -     TestMuPlus => (0.1056583745u"GeV" / speedoflight^2, 2.1969811e-6u"s"),
        -     TestEMinus => (0.00051099895000u"GeV" / speedoflight^2, Inf * u"s"),
        -     TestEPlus => (0.00051099895000u"GeV" / speedoflight^2, Inf * u"s"),
        - )
        - 
        - const test_range_params = Dict(
        -     TestMuMinus => (1.76666667e-1u"GeV*cm^3/m/g", 2.0916666667e-4u"cm^3/m/g"),
        -     TestMuPlus => (1.76666667e-1u"GeV*cm^3/m/g", 2.0916666667e-4u"cm^3/m/g"),
        -     TestTauMinus => (1.473684210526e3u"GeV*cm^3/m/g", 2.63e-5u"cm^3/m/g"),
        -     TestTauPlus => (1.473684210526e3u"GeV*cm^3/m/g", 2.63e-5u"cm^3/m/g"),
        - )
        - 
        3 function test_gamma_factor(ke, m)
        3     return ustrip(ke / m / speedoflight^2)
        - end
        - 
        2 function test_particle_vacuum_range(pdg::TestParticleType, energy, epsilon=1e-3)
        2     m, tau = test_particle_params[pdg]
        2     γ = test_gamma_factor(energy, m)
        2     return -γ * speedoflight * tau * log(epsilon)
        - end
        - 
        2 function test_particle_rock_range(e, pdg::TestParticleType)
        2     α, β = test_range_params[pdg]
        2     range = log(1 + e * β / α) / β
        2     return range
        - end
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_particle_tests()
        1     @testset "Particle Types" begin
        2         test_particle_types()
        1         test_fit_status()
        1         test_particle_shape()
        -     end
        - 
        0     @testset "Particle Construction" begin
        2         test_particle_default_construction()
        1         test_particle_full_construction()
        1         test_particle_with_pdg()
        -     end
        - 
        0     @testset "Particle Physics" begin
        2         test_gamma_factor_calc()
        1         test_vacuum_range()
        1         test_rock_range()
        -     end
        - 
        0     @testset "Particle to Ray" begin
        2         test_particle_to_ray()
        -     end
        - end
        - 
        1 function test_particle_types()
        1     @test Int(TestTauMinus) == 15
        1     @test Int(TestTauPlus) == -15
        1     @test Int(TestMuMinus) == 13
        1     @test Int(TestMuPlus) == -13
        1     @test Int(TestEMinus) == 11
        1     @test Int(TestEPlus) == -11
        1     @test Int(TestNuTau) == 16
        1     @test Int(TestNuTauBar) == -16
        1     @test Int(TestUnknown) == 0
        - end
        - 
        1 function test_fit_status()
        1     @test Int(TestNotSet) == -1
        1     @test Int(TestOK) == 0
        1     @test Int(TestGeneralFailure) == 10
        - end
        - 
        1 function test_particle_shape()
        1     @test Int(TestNull) == 0
        - end
        - 
        1 function test_particle_default_construction()
        1     p = TestParticle(Float64)
        - 
        1     @test p.id == 0
        1     @test p.pdg == TestUnknown
        2     @test isnan(ustrip(p.energy))
        1     @test p.status == TestNotSet
        1     @test p.shape == TestNull
        - end
        - 
        1 function test_particle_full_construction()
        1     cs = test_ecef
        1     pos = TestCoordinate([1.0u"m", 2.0u"m", 3.0u"m"], cs)
        3     dir = TestDirection([0.0, 0.0, 1.0], cs)
        1     energy = 100.0u"GeV"
        - 
        1     p = TestParticle(TestTauMinus, energy, pos, dir)
        - 
        1     @test p.pdg == TestTauMinus
        1     @test p.energy == 100.0u"GeV"
        1     @test p.position == pos
        1     @test p.direction == dir
        1     @test p.id == 0
        - end
        - 
        1 function test_particle_with_pdg()
        1     cs = test_ecef
        1     pos = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     dir = TestDirection([1.0, 0.0, 0.0], cs)
        1     energy = 1.0u"TeV"
        - 
        1     p_tau = TestParticle(TestTauMinus, energy, pos, dir)
        1     @test p_tau.pdg == TestTauMinus
        - 
        1     p_mu = TestParticle(TestMuMinus, energy, pos, dir)
        1     @test p_mu.pdg == TestMuMinus
        - 
        1     p_e = TestParticle(TestEMinus, energy, pos, dir)
        1     @test p_e.pdg == TestEMinus
        - end
        - 
        1 function test_gamma_factor_calc()
        1     ke = 10.0u"GeV"
        1     m = 0.1057u"GeV" / speedoflight^2  # muon mass
        - 
        1     g = test_gamma_factor(ke, m)
        - 
        -     # gamma = E / (m*c^2), so ~10 GeV / 0.1057 GeV ≈ 94.6
        1     @test g > 90
        1     @test g < 100
        - end
        - 
        1 function test_vacuum_range()
        1     pdg = TestTauMinus
        1     energy = 1000.0u"GeV"
        1     epsilon = 1e-3
        - 
        1     range = test_particle_vacuum_range(pdg, energy, epsilon)
        - 
        1     @test range > 0u"m"
        1     @test unit(range) == u"m"
        - 
        -     # Higher energy should give longer range
        1     range_high = test_particle_vacuum_range(pdg, 10000.0u"GeV", epsilon)
        1     @test range_high > range
        - end
        - 
        1 function test_rock_range()
        1     energy = 100.0u"GeV"
        1     pdg = TestMuMinus
        - 
        1     range = test_particle_rock_range(energy, pdg)
        - 
        -     # Range has units of m*g/cm^3 (mass per area times length)
        1     @test range > 0u"m*g/cm^3"
        - 
        -     # Higher energy should give longer range
        1     range_high = test_particle_rock_range(1000.0u"GeV", pdg)
        1     @test range_high > range
        - end
        - 
        1 function test_particle_to_ray()
        1     cs = test_ecef
        1     pos = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     dir = TestDirection([0.0, 0.0, 1.0], cs)
        1     energy = 100.0u"GeV"
        - 
        1     p = TestParticle(TestTauMinus, energy, pos, dir)
        1     ray = TestRay(p.position, p.direction)
        - 
        1     @test ray.origin == p.position
        1     @test ray.direction == p.direction
        - end
