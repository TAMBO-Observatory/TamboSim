        - """
        - Tests for the particles module including particle types and particle state.
        - 
        - These tests use the actual Tambo types from src/ to ensure code coverage.
        - """
        - 
        - # Import particle-related types and functions
        - import Tambo: ParticleType, Unknown, Gamma, EPlus, EMinus, MuPlus, MuMinus,
        -               TauPlus, TauMinus, NuTau, NuTauBar,
        -               FitStatus, NotSet, OK, GeneralFailure,
        -               ParticleShape, Null,
        -               particle_vacuum_range, particle_rock_range, gamma as gamma_factor,
        -               particle_parameters, range_parameters
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_particle_tests()
        1     @testset "Particle Types" begin
        2         test_particle_types()
        1         test_fit_status()
        1         test_particle_shape()
        -     end
        - 
        0     @testset "Particle Construction" begin
        2         test_particle_default_construction()
        1         test_particle_full_construction()
        1         test_particle_with_pdg()
        -     end
        - 
        0     @testset "Particle Physics" begin
        2         test_gamma_factor_calc()
        1         test_vacuum_range()
        1         test_rock_range()
        -     end
        - 
        0     @testset "Particle to Ray" begin
        2         test_particle_to_ray()
        -     end
        - end
        - 
        1 function test_particle_types()
        1     @test Int(TauMinus) == 15
        1     @test Int(TauPlus) == -15
        1     @test Int(MuMinus) == 13
        1     @test Int(MuPlus) == -13
        1     @test Int(EMinus) == 11
        1     @test Int(EPlus) == -11
        1     @test Int(NuTau) == 16
        1     @test Int(NuTauBar) == -16
        1     @test Int(Unknown) == 0
        - end
        - 
        1 function test_fit_status()
        1     @test Int(NotSet) == -1
        1     @test Int(OK) == 0
        1     @test Int(GeneralFailure) == 10
        - end
        - 
        1 function test_particle_shape()
        1     @test Int(Null) == 0
        - end
        - 
        1 function test_particle_default_construction()
        1     p = Particle(Float64)
        - 
        1     @test p.id == 0
        1     @test p.pdg == Unknown
        2     @test isnan(ustrip(p.energy))
        1     @test p.status == NotSet
        1     @test p.shape == Null
        - end
        - 
        1 function test_particle_full_construction()
        1     cs = ecefcoordinates
        1     pos = Coordinate([1.0u"m", 2.0u"m", 3.0u"m"], cs)
        1     dir = Direction([0.0, 0.0, 1.0], cs)
        1     energy = 100.0u"GeV"
        - 
        1     p = Particle(TauMinus, energy, pos, dir)
        - 
        1     @test p.pdg == TauMinus
        1     @test p.energy == 100.0u"GeV"
        1     @test p.position == pos
        1     @test p.direction == dir
        1     @test p.id == 0
        - end
        - 
        1 function test_particle_with_pdg()
        1     cs = ecefcoordinates
        1     pos = Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     dir = Direction([1.0, 0.0, 0.0], cs)
        1     energy = 1.0u"TeV"
        - 
        1     p_tau = Particle(TauMinus, energy, pos, dir)
        1     @test p_tau.pdg == TauMinus
        - 
        1     p_mu = Particle(MuMinus, energy, pos, dir)
        1     @test p_mu.pdg == MuMinus
        - 
        1     p_e = Particle(EMinus, energy, pos, dir)
        1     @test p_e.pdg == EMinus
        - end
        - 
        1 function test_gamma_factor_calc()
        1     ke = 10.0u"GeV"
        1     m = 0.1057u"GeV" / speedoflight^2  # muon mass
        - 
        1     g = gamma_factor(ke, m)
        - 
        -     # gamma = E / (m*c^2), so ~10 GeV / 0.1057 GeV ≈ 94.6
        1     @test g > 90
        1     @test g < 100
        - end
        - 
        1 function test_vacuum_range()
        1     pdg = TauMinus
        1     energy = 1000.0u"GeV"
        1     epsilon = 1e-3
        - 
        1     range = particle_vacuum_range(pdg, energy, epsilon)
        - 
        1     @test range > 0u"m"
        1     @test unit(range) == u"m"
        - 
        -     # Higher energy should give longer range
        1     range_high = particle_vacuum_range(pdg, 10000.0u"GeV", epsilon)
        1     @test range_high > range
        - end
        - 
        1 function test_rock_range()
        1     energy = 1000.0u"GeV"
        - 
        -     # Test muon rock range
        1     range_mu = particle_rock_range(energy, MuMinus)
        2     @test !isnan(ustrip(range_mu))
        1     @test ustrip(range_mu) > 0
        - 
        -     # Test tau rock range
        1     range_tau = particle_rock_range(energy, TauMinus)
        2     @test !isnan(ustrip(range_tau))
        1     @test ustrip(range_tau) > 0
        - 
        -     # Higher energy should give longer range
        1     range_high = particle_rock_range(10000.0u"GeV", MuMinus)
        1     @test ustrip(range_high) > ustrip(range_mu)
        - end
        - 
        1 function test_particle_to_ray()
        1     cs = ecefcoordinates
        1     pos = Coordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     dir = Direction([0.0, 0.0, 1.0], cs)
        1     energy = 100.0u"GeV"
        - 
        1     p = Particle(TauMinus, energy, pos, dir)
        1     ray = Ray(p)
        - 
        1     @test ray.origin == p.position
        1     @test ray.direction == p.direction
        - end
