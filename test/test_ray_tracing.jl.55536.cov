        - """
        - Tests for ray tracing functionality.
        - """
        - 
        - # ============================================================================
        - # Ray type definitions for testing
        - # ============================================================================
        - 
        - struct TestRay{T<:Real}
       14     origin::TestCoordinate{T}
        -     direction::TestDirection{T}
        - end
        - 
        1 function test_reverse_ray(ray::TestRay{T}) where {T}
        1     return TestRay{T}(ray.origin, reverse(ray.direction))
        - end
        - 
        - # Ray-triangle intersection using Möller–Trumbore algorithm
        6 function test_ray_triangle_intersect(ray::TestRay{T}, tri::TestTriangle{T}) where {T}
        6     EPSILON = 1e-9
        - 
        6     e1 = tri.v2.point - tri.v1.point
        6     e2 = tri.v3.point - tri.v1.point
        - 
        6     h = cross(ray.direction.point, ustrip.(e2))
        6     a = dot(ustrip.(e1), h)
        - 
        6     if abs(a) < EPSILON
        1         return nothing  # Ray is parallel to triangle
        -     end
        - 
        5     f = 1.0 / a
        5     s = ray.origin.point - tri.v1.point
        5     u = f * dot(ustrip.(s), h)
        - 
       10     if u < 0.0 || u > 1.0
        0         return nothing
        -     end
        - 
        5     q = cross(ustrip.(s), ustrip.(e1))
        5     v = f * dot(ray.direction.point, q)
        - 
       10     if v < 0.0 || u + v > 1.0
        0         return nothing
        -     end
        - 
        5     t = f * dot(ustrip.(e2), q)
        - 
        5     if t > EPSILON
        4         return t * u"m"  # Return distance as Quantity
        -     end
        - 
        1     return nothing
        - end
        - 
        - # Ray-sphere intersection
        2 function test_ray_sphere_intersect(ray::TestRay{T}, sphere::TestSphere{T}) where {T}
        2     oc = ray.origin.point - sphere.center.point
        2     a = dot(ray.direction.point, ray.direction.point)
        2     b = 2.0 * dot(ustrip.(oc), ray.direction.point)
        2     c = dot(ustrip.(oc), ustrip.(oc)) - ustrip(sphere.radius)^2
        - 
        2     discriminant = b^2 - 4*a*c
        - 
        2     if discriminant < 0
        1         return Quantity{T, ldim, typeof(u"m")}[]
        1     elseif discriminant == 0
        0         t = -b / (2*a)
        0         return t > 0 ? [t * u"m"] : Quantity{T, ldim, typeof(u"m")}[]
        -     else
        1         sqrtd = sqrt(discriminant)
        1         t1 = (-b - sqrtd) / (2*a)
        1         t2 = (-b + sqrtd) / (2*a)
        1         results = Quantity{T, ldim, typeof(u"m")}[]
        1         if t1 > 0
        1             push!(results, t1 * u"m")
        -         end
        1         if t2 > 0
        1             push!(results, t2 * u"m")
        -         end
        1         return results
        -     end
        - end
        - 
        - # Ray-plane intersection
        2 function test_ray_plane_intersect(ray::TestRay{T}, plane::TestPlane{T}) where {T}
        2     denom = dot(ray.direction.point, plane.normal.point)
        - 
        2     if abs(denom) < 1e-9
        1         return nothing, nothing  # Ray is parallel to plane
        -     end
        - 
        1     diff = plane.point.point - ray.origin.point
        1     t = dot(ustrip.(diff), plane.normal.point) / denom
        - 
        1     if t < 0
        0         return nothing, nothing
        -     end
        - 
        1     hit_point = TestCoordinate{T}(ray.origin.point + ray.direction.point * t * u"m", ray.origin.coordinate_system)
        1     return hit_point, t * u"m"
        - end
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_ray_tracing_tests()
        1     @testset "Ray" begin
        2         test_ray_construction()
        1         test_ray_reverse()
        -     end
        - 
        0     @testset "Triangle Intersection" begin
        2         test_triangle_intersection_hit()
        1         test_triangle_intersection_miss()
        1         test_triangle_intersection_parallel()
        -     end
        - 
        0     @testset "Sphere Intersection" begin
        2         test_sphere_intersection_through()
        1         test_sphere_intersection_miss()
        -     end
        - 
        0     @testset "Plane Intersection" begin
        2         test_plane_intersection_hit()
        1         test_plane_intersection_parallel()
        -     end
        - end
        - 
        1 function test_ray_construction()
        1     cs = test_ecef
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        - 
        1     ray = TestRay(origin, direction)
        - 
        1     @test ray.origin == origin
        1     @test ray.direction == direction
        - end
        - 
        1 function test_ray_reverse()
        1     cs = test_ecef
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        - 
        1     ray = TestRay(origin, direction)
        1     ray_rev = test_reverse_ray(ray)
        - 
        1     @test ray_rev.origin == ray.origin
        1     @test ray_rev.direction[1] ≈ -ray.direction[1]
        - end
        - 
        1 function test_triangle_intersection_hit()
        1     cs = test_ecef
        - 
        -     # Create a triangle in the XY plane at z=10
        1     v1 = TestCoordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v2 = TestCoordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v3 = TestCoordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        1     tri = TestTriangle(v1, v2, v3)
        - 
        -     # Ray pointing at the triangle
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([0.0, 0.0, 1.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     t = test_ray_triangle_intersect(ray, tri)
        - 
        4     @test !isnothing(t)
        1     @test t ≈ 10.0u"m"
        - end
        - 
        1 function test_triangle_intersection_miss()
        1     cs = test_ecef
        - 
        -     # Create a triangle in the XY plane at z=10
        1     v1 = TestCoordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v2 = TestCoordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v3 = TestCoordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        1     tri = TestTriangle(v1, v2, v3)
        - 
        -     # Ray pointing away from the triangle
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([0.0, 0.0, -1.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     t = test_ray_triangle_intersect(ray, tri)
        - 
        2     @test isnothing(t)
        - end
        - 
        1 function test_triangle_intersection_parallel()
        1     cs = test_ecef
        - 
        -     # Create a triangle in the XY plane at z=10
        1     v1 = TestCoordinate([-5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v2 = TestCoordinate([5.0u"m", -5.0u"m", 10.0u"m"], cs)
        1     v3 = TestCoordinate([0.0u"m", 5.0u"m", 10.0u"m"], cs)
        1     tri = TestTriangle(v1, v2, v3)
        - 
        -     # Ray parallel to the triangle
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     t = test_ray_triangle_intersect(ray, tri)
        - 
        2     @test isnothing(t)
        - end
        - 
        1 function test_sphere_intersection_through()
        1     cs = test_ecef
        - 
        -     # Create a sphere at the origin
        1     center = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     sphere = TestSphere(center, 10.0u"m")
        - 
        -     # Ray that passes through the sphere
        1     origin = TestCoordinate([-20.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     ts = test_ray_sphere_intersect(ray, sphere)
        - 
        1     @test length(ts) == 2
        1     @test ts[1] ≈ 10.0u"m"  # Entry at x=-10
        1     @test ts[2] ≈ 30.0u"m"  # Exit at x=+10
        - end
        - 
        1 function test_sphere_intersection_miss()
        1     cs = test_ecef
        - 
        -     # Create a sphere at the origin
        1     center = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        1     sphere = TestSphere(center, 10.0u"m")
        - 
        -     # Ray that misses the sphere
        1     origin = TestCoordinate([-20.0u"m", 20.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     ts = test_ray_sphere_intersect(ray, sphere)
        - 
        1     @test length(ts) == 0
        - end
        - 
        1 function test_plane_intersection_hit()
        1     cs = test_ecef
        - 
        -     # Create a plane at z=10
        1     point = TestCoordinate([0.0u"m", 0.0u"m", 10.0u"m"], cs)
        3     normal = TestDirection([0.0, 0.0, 1.0], cs)
        1     plane = TestPlane(point, normal)
        - 
        -     # Ray pointing at the plane
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([0.0, 0.0, 1.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        2     hit_point, t = test_ray_plane_intersect(ray, plane)
        - 
        4     @test !isnothing(hit_point)
        1     @test t ≈ 10.0u"m"
        1     @test hit_point[3] ≈ 10.0u"m"
        - end
        - 
        1 function test_plane_intersection_parallel()
        1     cs = test_ecef
        - 
        -     # Create a plane at z=10
        1     point = TestCoordinate([0.0u"m", 0.0u"m", 10.0u"m"], cs)
        3     normal = TestDirection([0.0, 0.0, 1.0], cs)
        1     plane = TestPlane(point, normal)
        - 
        -     # Ray parallel to the plane
        1     origin = TestCoordinate([0.0u"m", 0.0u"m", 0.0u"m"], cs)
        3     direction = TestDirection([1.0, 0.0, 0.0], cs)
        1     ray = TestRay(origin, direction)
        - 
        -     # Test intersection
        1     hit_point, t = test_ray_plane_intersect(ray, plane)
        - 
        2     @test isnothing(hit_point)
        2     @test isnothing(t)
        - end
