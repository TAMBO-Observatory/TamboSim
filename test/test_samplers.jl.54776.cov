        - """
        - Tests for the samplers module including power law sampler and angular sampler.
        - """
        - 
        - # ============================================================================
        - # Power Law Sampler for testing
        - # ============================================================================
        - 
        - struct TestPowerLawSampler{T<:Real}
        4     γ::T
        -     emin::Quantity{T, edim, typeof(u"GeV")}
        -     emax::Quantity{T, edim, typeof(u"GeV")}
        -     norm::Quantity{T, edim^-1, typeof(u"GeV^-1")}
        - end
        - 
        5 function test_pl_norm(γ, emin, emax)
        5     if γ == 1
        1         norm = 1 / (emin * log(emax / emin))
        1         return norm
        -     else
        4         mg = 1 - γ
        4         norm = mg / (emin^γ * (emax^mg - emin^mg))
        4         return norm
        -     end
        - end
        - 
        4 function TestPowerLawSampler(γ::T, emin, emax) where {T}
        4     norm = test_pl_norm(γ, emin, emax)
        4     return TestPowerLawSampler{T}(γ, emin, emax, norm)
        - end
        - 
      111 function Base.rand(pl::TestPowerLawSampler{T}) where {T}
      111     u = rand()
      111     if pl.γ == 1
       10         return pl.emin * exp(u / (pl.norm * pl.emin))
        -     else
      101         α = 1 - pl.γ
      101         return (u * α / pl.norm / pl.emin^pl.γ + pl.emin^α)^(1/α)
        -     end
        - end
        - 
        2 function Base.rand(pl::TestPowerLawSampler{T}, n::Int) where {T}
        2     return [rand(pl) for _ in 1:n]
        - end
        - 
        2 function (pl::TestPowerLawSampler{T})(e) where {T}
        2     return pl.norm * (e / pl.emin)^(-pl.γ)
        - end
        - 
        - # ============================================================================
        - # Uniform Angular Sampler for testing
        - # ============================================================================
        - 
        - struct TestAngularSampler
        -     θmin::Float64
        -     θmax::Float64
        -     ϕmin::Float64
        -     ϕmax::Float64
        7     function TestAngularSampler(θmin, θmax, ϕmin, ϕmax)
        8         @assert ϕmin <= ϕmax "ϕmin greater than ϕmax"
        7         @assert θmin <= θmax "θmin greater than θmax"
        6         @assert ϕmax - ϕmin <= 2π "Azimuthal range is greater than one period"
        4         return new(θmin, θmax, ϕmin, ϕmax)
        -     end
        - end
        - 
      101 function Base.rand(sampler::TestAngularSampler)
        -     # Uniform in cos(theta)
      101     θ = acos(rand(Uniform(cos(sampler.θmax), cos(sampler.θmin))))
      101     ϕ = rand(Uniform(sampler.ϕmin, sampler.ϕmax))
      101     return θ, ϕ
        - end
        - 
        1 function Base.rand(sampler::TestAngularSampler, cs::TestCoordinateSystem)
        1     theta, phi = rand(sampler)
        1     d = test_sph_to_cart(theta, phi)
        1     return TestDirection(d, cs)
        - end
        - 
        1 function test_angular_probability(sampler::TestAngularSampler, θ, ϕ)
        1     @assert sampler.θmin <= θ && θ <= sampler.θmax "Zenith angle out of phase space"
        1     @assert sampler.ϕmin <= ϕ && ϕ <= sampler.ϕmax "Azimuth angle out of phase space"
        1     Ω = (sampler.ϕmax - sampler.ϕmin) * (cos(sampler.θmin) - cos(sampler.θmax))
        1     return 1 / Ω
        - end
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_sampler_tests()
        1     @testset "PowerLaw Sampler" begin
        2         test_powerlaw_construction()
        1         test_powerlaw_normalization()
        1         test_powerlaw_sampling()
        1         test_powerlaw_pdf()
        1         test_powerlaw_gamma_one()
        -     end
        - 
        0     @testset "Uniform Angular Sampler" begin
        2         test_angular_sampler_construction()
        1         test_angular_sampler_sampling()
        1         test_angular_sampler_probability()
        1         test_angular_sampler_with_coordinate_system()
        -     end
        - 
        0     @testset "Sampler Edge Cases" begin
        2         test_angular_sampler_edge_cases()
        -     end
        - end
        - 
        1 function test_powerlaw_construction()
        1     emin = 1.0u"GeV"
        1     emax = 1000.0u"GeV"
        1     gamma = 2.0
        - 
        1     pl = TestPowerLawSampler(gamma, emin, emax)
        - 
        1     @test pl.γ == gamma
        1     @test pl.emin == emin
        1     @test pl.emax == emax
        2     @test !isnan(pl.norm)
        - end
        - 
        1 function test_powerlaw_normalization()
        1     emin = 1.0u"GeV"
        1     emax = 100.0u"GeV"
        1     gamma = 2.0
        - 
        1     norm = test_pl_norm(gamma, emin, emax)
        - 
        2     @test !isnan(norm)
        1     @test norm > 0.0u"GeV^-1"
        - end
        - 
        1 function test_powerlaw_sampling()
        1     emin = 1.0u"GeV"
        1     emax = 1000.0u"GeV"
        1     gamma = 2.0
        - 
        1     pl = TestPowerLawSampler(gamma, emin, emax)
        - 
        -     # Sample multiple energies
        1     samples = rand(pl, 100)
        - 
        1     @test length(samples) == 100
      102     @test all(s -> s >= emin && s <= emax, samples)
        - 
        -     # Single sample
        1     single = rand(pl)
        1     @test single >= emin
        1     @test single <= emax
        - end
        - 
        1 function test_powerlaw_pdf()
        1     emin = 1.0u"GeV"
        1     emax = 100.0u"GeV"
        1     gamma = 2.0
        - 
        1     pl = TestPowerLawSampler(gamma, emin, emax)
        - 
        -     # PDF should be higher at lower energies for gamma > 1
        1     pdf_low = pl(2.0u"GeV")
        1     pdf_high = pl(50.0u"GeV")
        - 
        1     @test pdf_low > pdf_high
        - end
        - 
        1 function test_powerlaw_gamma_one()
        -     # Special case: gamma = 1 (logarithmic)
        1     emin = 1.0u"GeV"
        1     emax = 100.0u"GeV"
        1     gamma = 1.0
        - 
        1     pl = TestPowerLawSampler(gamma, emin, emax)
        - 
        -     # Should not throw and should sample correctly
        1     samples = rand(pl, 10)
        1     @test length(samples) == 10
       12     @test all(s -> s >= emin && s <= emax, samples)
        - end
        - 
        1 function test_angular_sampler_construction()
        1     θmin = 0.0
        1     θmax = π/2
        1     ϕmin = 0.0
        1     ϕmax = 2π
        - 
        1     sampler = TestAngularSampler(θmin, θmax, ϕmin, ϕmax)
        - 
        1     @test sampler.θmin == θmin
        1     @test sampler.θmax == θmax
        1     @test sampler.ϕmin == ϕmin
        1     @test sampler.ϕmax == ϕmax
        - end
        - 
        1 function test_angular_sampler_sampling()
        1     θmin = 0.0
        1     θmax = π/2
        1     ϕmin = 0.0
        1     ϕmax = 2π
        - 
        1     sampler = TestAngularSampler(θmin, θmax, ϕmin, ϕmax)
        - 
        -     # Sample multiple angles
        1     for _ in 1:100
      100         θ, ϕ = rand(sampler)
      200         @test θ >= θmin && θ <= θmax
      200         @test ϕ >= ϕmin && ϕ <= ϕmax
      100     end
        - end
        - 
        1 function test_angular_sampler_probability()
        1     θmin = 0.0
        1     θmax = π/2
        1     ϕmin = 0.0
        1     ϕmax = 2π
        - 
        1     sampler = TestAngularSampler(θmin, θmax, ϕmin, ϕmax)
        - 
        -     # Test probability within range
        1     θ = π/4
        1     ϕ = π
        - 
        1     prob = test_angular_probability(sampler, θ, ϕ)
        - 
        2     @test !isnan(prob)
        1     @test prob > 0.0
        - 
        -     # Solid angle for this range: 2π * (cos(0) - cos(π/2)) = 2π
        1     expected_Ω = 2π * (cos(θmin) - cos(θmax))
        1     @test prob ≈ 1 / expected_Ω
        - end
        - 
        1 function test_angular_sampler_with_coordinate_system()
        1     θmin = 0.0
        1     θmax = π
        1     ϕmin = 0.0
        1     ϕmax = 2π
        - 
        1     sampler = TestAngularSampler(θmin, θmax, ϕmin, ϕmax)
        1     cs = test_ecef
        - 
        -     # Sample direction
        1     direction = rand(sampler, cs)
        - 
        1     @test direction isa TestDirection
        1     @test norm(direction.point) ≈ 1.0
        1     @test direction.coordinate_system == cs
        - end
        - 
        1 function test_angular_sampler_edge_cases()
        -     # Test assertion for invalid ranges
        3     @test_throws AssertionError TestAngularSampler(π, 0, 0, 2π)  # θmin > θmax
        3     @test_throws AssertionError TestAngularSampler(0, π, 2π, 0)  # ϕmin > ϕmax
        2     @test_throws AssertionError TestAngularSampler(0, π, 0, 3π)  # ϕmax - ϕmin > 2π
        - end
