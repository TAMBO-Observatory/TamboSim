        - """
        - Tests for the weighting module including weight parameters and calculations.
        - """
        - 
        - # ============================================================================
        - # Weight Parameters for testing
        - # ============================================================================
        - 
        - struct TestWeightParameters{T<:Real}
        3     area::Quantity{T, ldim^2, typeof(u"m^2")}
        -     emin::Quantity{T, edim, typeof(u"GeV")}
        -     emax::Quantity{T, edim, typeof(u"GeV")}
        -     gamma::T
        -     thetamin::T
        -     thetamax::T
        -     phimin::T
        -     phimax::T
        -     generated_initial_e::Quantity{T, edim, typeof(u"GeV")}
        -     generated_final_e::Quantity{T, edim, typeof(u"GeV")}
        -     generated_cd::Quantity{T, mdim/ldim^2, typeof(u"g/cm^2")}
        -     generated_density::Quantity{T, mdim/ldim^3, typeof(u"g/cm^3")}
        -     generated_xs::Quantity{T, ldim^2, typeof(u"cm^2")}
        -     generated_diff_xs::Quantity{T, ldim^2, typeof(u"cm^2")}
        - end
        - 
        - const test_null_params = TestWeightParameters{Float64}(
        -     NaN * u"m^2",
        -     NaN * u"GeV",
        -     NaN * u"GeV",
        -     NaN,
        -     NaN,
        -     NaN,
        -     NaN,
        -     NaN,
        -     NaN * u"GeV",
        -     NaN * u"GeV",
        -     NaN * u"g/cm^2",
        -     NaN * u"g/cm^3",
        -     NaN * u"cm^2",
        -     NaN * u"cm^2"
        - )
        - 
        - # ============================================================================
        - # Weighting functions for testing
        - # ============================================================================
        - 
        - """
        - Calculate power law PDF value.
        - """
        2 function test_pl_pdf(γ, emin, emax, e)
        2     if γ == 1
        0         norm = 1 / (emin * log(emax / emin))
        -     else
        2         mg = 1 - γ
        2         norm = mg / (emin^γ * (emax^mg - emin^mg))
        -     end
        2     return norm * (e / emin)^(-γ)
        - end
        - 
        - """
        - Calculate solid angle.
        - """
        2 function test_solid_angle(θmin, θmax, ϕmin, ϕmax)
        2     return (ϕmax - ϕmin) * (cos(θmin) - cos(θmax))
        - end
        - 
        - """
        - Calculate Monte Carlo probability density.
        - """
        3 function test_p_mc(
        -     area,
        -     emin,
        -     emax,
        -     gamma,
        -     thetamin,
        -     thetamax,
        -     phimin,
        -     phimax,
        -     generated_initial_e,
        -     generated_cd,
        -     generated_density,
        -     generated_xs,
        -     generated_diff_xs
        - )
        3     if generated_initial_e == 0.0u"GeV"
        1         return 0.0u"GeV^-1 * m^-3"
        -     end
        - 
        -     # Power law PDF
        2     pdf_e = test_pl_pdf(gamma, emin, emax, generated_initial_e)
        - 
        -     # Solid angle
        2     Ω = test_solid_angle(thetamin, thetamax, phimin, phimax)
        - 
        -     # MC probability
        2     p = pdf_e / area / Ω
        - 
        2     return p
        - end
        - 
        1 function test_p_mc(wp::TestWeightParameters)
        1     return test_p_mc(
        -         wp.area,
        -         wp.emin,
        -         wp.emax,
        -         wp.gamma,
        -         wp.thetamin,
        -         wp.thetamax,
        -         wp.phimin,
        -         wp.phimax,
        -         wp.generated_initial_e,
        -         wp.generated_cd,
        -         wp.generated_density,
        -         wp.generated_xs,
        -         wp.generated_diff_xs
        -     )
        - end
        - 
        - """
        - Calculate physical probability density (interaction probability per unit length).
        - """
        2 function test_p_phys(
        -     physical_cd,
        -     physical_density,
        -     physical_diff_xs
        - )
        2     if isnan(ustrip(physical_cd))
        1         return 0.0u"m^-1"
        -     end
        - 
        -     # Simple interaction probability per unit length
        -     # P/L = n * σ where n is number density (1/volume)
        -     # n = ρ * N_A / M, where N_A/M ≈ 6e23 / (1 g) for hydrogen-like target
        -     # For simplicity, use an approximate N_A/M factor
        1     N_A_over_M = 6.022e23u"g^-1"  # Avogadro's number per gram
        - 
        -     # P/L = ρ * (N_A/M) * σ has units: (g/cm^3) * (1/g) * cm^2 = cm^-1 -> m^-1
        1     p = physical_density * N_A_over_M * physical_diff_xs |> u"m^-1"
        - 
        1     return abs(p)
        - end
        - 
        - # ============================================================================
        - # Test functions
        - # ============================================================================
        - 
        1 function run_weighting_tests()
        1     @testset "Weight Parameters" begin
        2         test_weight_parameters_construction()
        1         test_null_weight_parameters()
        -     end
        - 
        0     @testset "Monte Carlo Probability" begin
        2         test_p_mc_basic()
        1         test_p_mc_with_weight_params()
        1         test_p_mc_zero_energy()
        -     end
        - 
        0     @testset "Physical Probability" begin
        2         test_p_phys_basic()
        1         test_p_phys_nan_cd()
        -     end
        - end
        - 
        - # Weight Parameters tests
        1 function test_weight_parameters_construction()
        1     wp = TestWeightParameters(
        -         100.0u"m^2",      # area
        -         1.0u"GeV",        # emin
        -         1000.0u"GeV",     # emax
        -         2.0,              # gamma
        -         0.0,              # thetamin
        -         Float64(π/2),     # thetamax
        -         0.0,              # phimin
        -         Float64(2π),      # phimax
        -         100.0u"GeV",      # generated_initial_e
        -         50.0u"GeV",       # generated_final_e
        -         100.0u"g/cm^2",   # generated_cd
        -         2.65u"g/cm^3",    # generated_density
        -         1e-36u"cm^2",     # generated_xs
        -         1e-37u"cm^2"      # generated_diff_xs
        -     )
        - 
        1     @test wp.area == 100.0u"m^2"
        1     @test wp.emin == 1.0u"GeV"
        1     @test wp.emax == 1000.0u"GeV"
        1     @test wp.gamma == 2.0
        1     @test wp.generated_initial_e == 100.0u"GeV"
        - end
        - 
        1 function test_null_weight_parameters()
        1     null_wp = test_null_params
        - 
        2     @test isnan(ustrip(null_wp.area))
        2     @test isnan(ustrip(null_wp.emin))
        2     @test isnan(ustrip(null_wp.generated_initial_e))
        - end
        - 
        - # Monte Carlo Probability tests
        1 function test_p_mc_basic()
        -     # Test basic p_mc calculation
        1     p = test_p_mc(
        -         100.0u"m^2",      # area
        -         1.0u"GeV",        # emin
        -         1000.0u"GeV",     # emax
        -         2.0,              # gamma
        -         0.0,              # thetamin
        -         Float64(π/2),     # thetamax
        -         0.0,              # phimin
        -         Float64(2π),      # phimax
        -         100.0u"GeV",      # generated_initial_e
        -         100.0u"g/cm^2",   # generated_cd
        -         2.65u"g/cm^3",    # generated_density
        -         1e-36u"cm^2",     # generated_xs
        -         1e-37u"cm^2"      # generated_diff_xs
        -     )
        - 
        2     @test !isnan(ustrip(p))
        1     @test p > 0.0u"GeV^-1 * m^-2"
        - end
        - 
        1 function test_p_mc_with_weight_params()
        1     wp = TestWeightParameters(
        -         100.0u"m^2",
        -         1.0u"GeV",
        -         1000.0u"GeV",
        -         2.0,
        -         0.0,
        -         Float64(π/2),
        -         0.0,
        -         Float64(2π),
        -         100.0u"GeV",
        -         50.0u"GeV",
        -         100.0u"g/cm^2",
        -         2.65u"g/cm^3",
        -         1e-36u"cm^2",
        -         1e-37u"cm^2"
        -     )
        - 
        1     p = test_p_mc(wp)
        - 
        2     @test !isnan(ustrip(p))
        1     @test p >= 0.0u"GeV^-1 * m^-2"
        - end
        - 
        1 function test_p_mc_zero_energy()
        -     # Zero energy should return zero probability
        1     p = test_p_mc(
        -         100.0u"m^2",
        -         1.0u"GeV",
        -         1000.0u"GeV",
        -         2.0,
        -         0.0,
        -         Float64(π/2),
        -         0.0,
        -         Float64(2π),
        -         0.0u"GeV",        # Zero initial energy
        -         100.0u"g/cm^2",
        -         2.65u"g/cm^3",
        -         1e-36u"cm^2",
        -         1e-37u"cm^2"
        -     )
        - 
        1     @test p == 0.0u"GeV^-1 * m^-3"
        - end
        - 
        - # Physical Probability tests
        1 function test_p_phys_basic()
        1     p = test_p_phys(
        -         100.0u"g/cm^2",   # physical_cd
        -         2.65u"g/cm^3",    # physical_density
        -         1e-36u"cm^2"      # physical_diff_xs
        -     )
        - 
        2     @test !isnan(ustrip(p))
        1     @test p >= 0.0u"m^-1"
        - end
        - 
        1 function test_p_phys_nan_cd()
        -     # NaN column depth should return zero probability
        1     p = test_p_phys(
        -         NaN * u"g/cm^2",
        -         2.65u"g/cm^3",
        -         1e-36u"cm^2"
        -     )
        - 
        1     @test p == 0.0u"m^-1"
        - end
